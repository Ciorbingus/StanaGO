@using Microsoft.AspNetCore.Identity
@using StanaGO.Models
@using StanaGO.Enums

@model List<StanaGO.Models.Threat>
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Amenințări Raportate";
    var currentUserId = UserManager.GetUserId(User);
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-triangle-exclamation text-danger"></i> Amenințări în Zonă</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success text-center mb-4">
            <i class="fa-solid fa-check-circle"></i> Nu există amenințări active în raza fermelor tale.
        </div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <a asp-action="AddThreat" class="text-decoration-none">
                <div class="card h-100 border-dashed d-flex align-items-center justify-content-center bg-light text-danger"
                     style="border: 2px dashed #dc3545; min-height: 300px; cursor: pointer; transition: 0.3s;">
                    <div class="text-center">
                        <h1 class="display-4 mb-0">+</h1>
                        <span class="fw-bold">Raportează Pericol</span>
                    </div>
                </div>
            </a>
        </div>

        @foreach (var item in Model)
        {
            var isWolf = item.Type == ThreatType.Wolf;
            var headerClass = isWolf ? "bg-danger" : "bg-warning text-dark";
            var iconClass = isWolf ? "fa-dog" : "fa-paw";
            var typeName = isWolf ? "Lup" : "Urs";

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm hover-effect">

                    <div class="card-header @headerClass text-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fa-solid @iconClass"></i> @typeName
                        </h5>
                        <small>@item.TimeReported.ToString("dd MMM HH:mm")</small>
                    </div>

                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="~/images/threats/@item.ImagePath" class="card-img-top" alt="Threat Image" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fa-regular fa-image fa-3x opacity-50"></i>
                        </div>
                    }

                    <div class="card-body">
                        <p class="card-text text-muted">
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                            }
                            else
                            {
                                <em class="text-muted small">Fără descriere.</em>
                            }
                        </p>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Threat" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm">
                                Vezi Detalii &rarr;
                            </a>

                            @if (item.ReporterId == currentUserId)
                            {
                                <form asp-action="DeleteThreat" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Ștergi această alertă?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm border-0" title="Șterge">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-effect {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .border-dashed:hover {
        background-color: #f8d7da !important;
    }
</style>