@using StanaGO.Enums
@model StanaGO.ViewModels.ThreatViewModel

@{
    ViewData["Title"] = "Raportează Pericol";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4">
    <h2><i class="fa-solid fa-circle-exclamation text-danger"></i> Raportează o Amenințare</h2>
    <p class="text-muted">Selectează tipul pericolului și confirmă locația pe hartă.</p>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <form asp-action="AddThreat" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Type" class="form-label fw-bold">Ce ai văzut?</label>
                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ThreatType>()">
                        <option value="">-- Selectează --</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Detalii (Opțional)</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ex: Am văzut urme lângă râu..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ImageFile" class="form-label fw-bold">Poză (Opțional)</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <input type="hidden" asp-for="Latitude" id="Lat" />
                <input type="hidden" asp-for="Longitude" id="Lng" />

                <div class="alert alert-warning">
                    <small>Locație selectată:</small><br />
                    <strong>Lat:</strong> <span id="displayLat">-</span> <br />
                    <strong>Lng:</strong> <span id="displayLng">-</span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger">Raportează Acum</button>
                    <a asp-action="Threats" class="btn btn-light border">Anulează</a>
                </div>
            </form>
        </div>

        <div class="col-md-8">
            <label class="form-label fw-bold">Confirmă locația pe hartă (Click pentru a muta)</label>
            <div id="map" style="height: 600px; width: 100%; border-radius: 8px; border: 2px solid #dc3545;"></div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([46.0, 25.0], 7);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var marker;

        function updateLocation(lat, lng) {
            document.getElementById('Lat').value = lat;
            document.getElementById('Lng').value = lng;
            document.getElementById('displayLat').innerText = lat.toFixed(5);
            document.getElementById('displayLng').innerText = lng.toFixed(5);
        }

        function onMapClick(e) {
            if (marker) {
                marker.setLatLng(e.latlng);
            } else {
                marker = L.marker(e.latlng).addTo(map);
            }
            updateLocation(e.latlng.lat, e.latlng.lng);
        }

        map.on('click', onMapClick);

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                var lat = position.coords.latitude;
                var lng = position.coords.longitude;
                map.setView([lat, lng], 14);
                marker = L.marker([lat, lng]).addTo(map);
                updateLocation(lat, lng);
            });
        }
    </script>
}