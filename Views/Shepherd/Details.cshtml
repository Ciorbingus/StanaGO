@model StanaGO.Models.Sheepfarm

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card bg-light border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="display-6">@Model.Name</h1>
                        <p class="text-muted mb-0">📍 @Model.Address</p>
                    </div>
                    <div>
                        <a asp-action="AddProduct" asp-route-farmId="@Model.Id" class="btn nav-bg-color btn-lg shadow text-white">
                           Adaugă Produs
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <h4 class="mb-3">Produse disponibile</h4>

            @if (Model.Products == null || !Model.Products.Any())
            {
                <div class="alert alert-warning text-center p-5">
                    <h4>Încă nu ai adăugat produse.</h4>
                    <p>Adaugă brânză, lână sau alte bunătăți pentru a le vinde!</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var prod in Model.Products)
                    {
                        <div class="col-md-3 mb-4">
                            <div class="card h-100 shadow-sm">
                                @if (!string.IsNullOrEmpty(prod.ImagePath))
                                {
                                    <img src="~/images/products/@prod.ImagePath" class="card-img-top" alt="@prod.Name" style="height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">Fără Poză</div>
                                }

                                <div class="card-body">
                                    <h5 class="card-title">@prod.Name</h5>
                                    <p class="card-text small text-muted">@prod.Description</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="badge nav-bg-color">@prod.Price RON</span>
                                        <span class="text-muted small">@prod.Status</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="YourFarms">⬅ Înapoi la lista de stâne</a>
    </div>
</div>