@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

@* Harta *@
<div class="container-fluid p-0">
    <div id="map" style="height: 600px; width: 100%; z-index: 0; position: relative;"></div>
</div>

@* Afisare produse locale *@
<div class="container mt-4 mb-5">
    <h3 class="mb-3 text-dark">
        Oferte proaspete în zona ta curentă.
    </h3>

    <div id="products-container" class="row">
        <div class="col-12 text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Te localizăm pentru a găsi stânele...</p>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var romaniaBounds = [ [43.5, 20.2], [48.7, 29.7] ];
        var minZoomForMarkers = 10;

        var sheepIcon = L.icon({
            iconUrl: '/images/icons/sheepfarmIcon.png',
            iconSize: [40, 40],
            iconAnchor: [20, 40],
            popupAnchor: [0, -40]
        });

        var wolfIcon = L.icon({
            iconUrl: '/images/icons/wolfIcon.png',
            iconSize: [40, 40],
            iconAnchor: [20, 40],
            popupAnchor: [0, -40]
        });

        var bearIcon = L.icon({
            iconUrl: '/images/icons/bearIcon.png',
            iconSize: [40, 40],
            iconAnchor: [20, 40],
            popupAnchor: [0, -40]
        });

        var map = L.map('map',
        {
            center: [45.9, 24.7],
            zoom: 7,
            minZoom: 6,
            maxZoom: 16,
            maxBounds: romaniaBounds,
            maxBoundsViscosity: 0.9,
            preferCanvas: true
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var userMarker = null;
        var radiusCircle = null;
        var markersLayer = L.layerGroup();
        var dataLoaded = false;

        map.on('zoomend', function()
        {
            checkZoomLevel();
        });

        function checkZoomLevel()
        {
            var currentZoom = map.getZoom();

            if (currentZoom >= minZoomForMarkers)
            {
                if (!map.hasLayer(markersLayer))
                {
                    map.addLayer(markersLayer);
                }
            }
            else
            {
                if (map.hasLayer(markersLayer))
                {
                    map.removeLayer(markersLayer);
                }
            }
        }

        if (navigator.geolocation)
        {
            var geoOptions = {
                enableHighAccuracy: true,
                timeout: 5000,
                maximumAge: 60000
            };
            navigator.geolocation.getCurrentPosition(successPosition, errorPosition, geoOptions);
        }
        else
        {
            document.getElementById('products-container').innerHTML =
                '<div class="col-12 text-center text-danger">Browserul tău nu suportă localizarea.</div>';
        }

        function successPosition(position)
        {
            var lat = position.coords.latitude;
            var lon = position.coords.longitude;

            map.setView([lat, lon], 11);

            if (!userMarker)
            {
                userMarker = L.marker([lat, lon]).addTo(map).bindPopup("<b>Ești aici!</b>").openPopup();
            }

            if (!radiusCircle)
            {
                radiusCircle = L.circle([lat, lon],
                {
                    color: '#0d6efd',
                    fillColor: '#0d6efd',
                    fillOpacity: 0.1,
                    radius: 20000
                }).addTo(map);
            }

            if (!dataLoaded)
            {
                loadNearbyData(lat, lon);
                dataLoaded = true;
            }
        }

        function errorPosition(error)
        {
            console.error("Eroare locație: ", error);
            document.getElementById('products-container').innerHTML =
                `<div class="col-12 text-center alert alert-warning">
                    Nu te-am putut localiza automat. Harta rămâne centrată pe România.
                 </div>`;
        }

        @* Script functie incarcare date din apropriere *@
        function loadNearbyData(lat, lng)
        {
            fetch(`/Home/GetNearbyData?lat=${lat}&lng=${lng}`)
                .then(response => response.json())
                .then(data => {

                    markersLayer.clearLayers();

                    if(data.farms) {
                        data.farms.forEach(farm => {
                            var marker = L.marker([farm.latitude, farm.longitude], {icon: sheepIcon})
                                .bindPopup(`
                                    <div style="text-align:center; min-width: 150px;">
                                        <h6 style="margin-bottom:5px; font-weight:bold;">${farm.name}</h6>
                                        <p style="font-size:0.9em; color:#666; margin-bottom:10px;">
                                            ${farm.address}
                                        </p>
                                        <a href="/Shepherd/Sheepfarm/${farm.id}" class="btn btn-sm btn-primary text-white w-100">
                                            Vezi Stâna
                                        </a>
                                    </div>
                                `);
                            markersLayer.addLayer(marker);
                        });
                    }

                    if(data.threats && data.threats.length > 0) {
                        data.threats.forEach(threat => {

                            var icon = (threat.type === "Wolf" || threat.type === 0) ? wolfIcon : bearIcon;
                            var typeName = (threat.type === "Wolf" || threat.type === 0) ? "Lup" : "Urs";
                            var colorClass = (threat.type === "Wolf" || threat.type === 0) ? "text-danger" : "text-warning";

                            var marker = L.marker([threat.latitude, threat.longitude], {icon: icon})
                                .bindPopup(`
                                    <div style="text-align:center; min-width: 150px;">
                                        <h6 style="margin-bottom:5px; font-weight:bold;" class="${colorClass}">
                                            <i class="fa-solid fa-triangle-exclamation"></i> ${typeName}
                                        </h6>
                                        <p style="font-size:0.8em; color:#666; margin-bottom:5px;">
                                            Raportat: ${threat.time}
                                        </p>
                                        <a href="/Shepherd/Threat/${threat.id}" class="btn btn-sm btn-outline-danger w-100">
                                            Vezi Detalii
                                        </a>
                                    </div>
                                `);
                            markersLayer.addLayer(marker);
                        });
                    }

                    checkZoomLevel();

                    if(data.products) {
                        renderProducts(data.products);
                    }
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById('products-container').innerHTML =
                        '<div class="col-12 text-center text-danger">A apărut o eroare la încărcarea datelor.</div>';
                });
        }

        @* Script functie incarcare produse din apropriere *@
        function renderProducts(products)
        {
            var container = document.getElementById('products-container');

            if (!products || products.length === 0)
            {
                container.innerHTML = `
                    <div class="col-12">
                        <div class="alert alert-warning text-center shadow-sm">
                            <h4>Nicio stână găsită în apropiere.</h4>
                            <p class="mb-0">Încearcă să cauți în alte zone!</p>
                        </div>
                    </div>`;
                return;
            }

            let allHtml = "";

            products.forEach(prod => {
                var imgUrl = prod.image ? `/images/products/${prod.image}` : 'https://via.placeholder.com/300x200?text=Fara+Poza';

                var cardHtml = `
                    <div class="col-md-3 mb-4">
                        <div class="card h-100 shadow-sm border-0 hover-effect">
                            <div style="position: relative;">
                                <img src="${imgUrl}" class="card-img-top"
                                     loading="lazy"
                                     style="height: 180px; object-fit: cover; border-radius: 5px 5px 0 0;">

                                <span class="badge stana-go-theme" style="position: absolute; top: 10px; right: 10px;">
                                    ${prod.price} RON
                                </span>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title text-truncate" title="${prod.name}">${prod.name}</h5>
                                <p class="card-text text-muted small mb-2">
                                    <strong>${prod.farmName}</strong> <br/>
                                    <span class="text-info">Distanță: ${prod.distance}</span>
                                </p>
                                <div class="d-grid">
                                   <a href="/Shepherd/Product/${prod.id}" class="stretched-link"></a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                allHtml += cardHtml;
            });

            container.innerHTML = allHtml;
        }
    </script>
}

<style>
    .hover-effect {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .hover-effect:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
        }
</style>