@{
    ViewData["Title"] = "Bun venit";
}

<div class="container py-4">

    <div class="hero-section">
        <div class="brand-icon">
            <i class="fa-solid fa-mountain-sun fa-5x"></i>
        </div>

        <h1 class="display-4 welcome-title">Bine ai venit la StanaGO!</h1>
        <p class="welcome-text">
            Descoperă gustul autentic al produselor locale.
            Conectăm iubitorii de natură cu cele mai bune stâne și produse tradiționale din România.
        </p>

        <div class="d-flex justify-content-center gap-3">
            <a href="/Account/Login" class="btn btn-primary btn-authentification text-uppercase">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Autentificare
            </a>
            <a href="/Account/Register" class="btn btn-primary btn-authentification text-uppercase">
                <i class="fa-solid fa-user-plus me-2"></i> Înregistrare
            </a>
        </div>
    </div>

    <div class="row g-4 text-center">

        <div class="col-md-4">
            <div class="card p-4 shadow-sm feature-card">
                <div class="d-flex justify-content-center">
                    <div class="feature-icon">
                        <i class="fa-solid fa-location-dot fa-2x"></i>
                    </div>
                </div>
                <h5 class="fw-bold">Localizare Exactă</h5>
                <p class="text-muted small">Găsește stânele din apropierea ta folosind harta interactivă și GPS-ul.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 shadow-sm feature-card">
                <div class="d-flex justify-content-center">
                    <div class="feature-icon">
                        <i class="fa-solid fa-cheese fa-2x"></i>
                    </div>
                </div>
                <h5 class="fw-bold">Produse Proaspete</h5>
                <p class="text-muted small">Vezi ce produse sunt disponibile azi: brânză, lapte, sau lână direct de la sursă.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 shadow-sm feature-card">
                <div class="d-flex justify-content-center">
                    <div class="feature-icon">
                        <i class="fa-solid fa-shield-halved fa-2x"></i>
                    </div>
                </div>
                <h5 class="fw-bold">Alerte Pericole</h5>
                <p class="text-muted small">Ciobanii raportează prezența prădătorilor (urși, lupi) pentru siguranța ta.</p>
            </div>
        </div>

    </div>
</div>