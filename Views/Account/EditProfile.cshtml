@model StanaGO.ViewModels.EditProfileViewModel

<h2>Editare Profil</h2>

<form asp-action="EditProfile" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label asp-for="Username"></label>
        <input asp-for="Username" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="AvatarUrl"></label>
        <input asp-for="AvatarUrl" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="LocationText"></label>
        <input asp-for="LocationText" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Bio"></label>
        <textarea asp-for="Bio" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success mt-3">💾 Salvează</button>
</form>
