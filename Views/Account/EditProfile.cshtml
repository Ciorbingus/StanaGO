@model StanaGO.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Editează Profilul";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 text-primary">Actualizare Date Personale</h4>
                </div>
                <div class="card-body p-4">

                    <form asp-action="EditProfile" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row mb-4 align-items-center">
                            <div class="col-md-3 text-center">
                                @if (!string.IsNullOrEmpty(Model.CurrentProfilePicture))
                                {
                                    <img src="/images/profiles/@Model.CurrentProfilePicture" class="rounded-circle shadow" style="width: 80px; height: 80px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle d-inline-block" style="width: 80px; height: 80px;"></div>
                                }
                            </div>
                            <div class="col-md-9">
                                <label asp-for="ProfileImage" class="form-label fw-bold">Schimbă Poza</label>
                                <input asp-for="ProfileImage" class="form-control" type="file" accept="image/*" />
                                <span asp-validation-for="ProfileImage" class="text-danger"></span>
                            </div>
                        </div>
                         @if (User.IsInRole("Shepherd"))
                         {
                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label">Număr de Telefon</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="07xx xxx xxx" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                         }
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Adresă / Locație</label>

                            <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">Prenume</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">Nume</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Adresă / Locație</label>
                            <input asp-for="Address" class="form-control" placeholder="Ex: Sibiu, Str. Principală..." />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Bio" class="form-label">Despre Mine</label>
                            <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Scrie câteva cuvinte..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Profile" class="btn btn-light border">Anulează</a>
                            <button type="submit" class="btn btn-success px-4">Salvează Modificările</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}