@model StanaGO.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Înregistrare";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card authentification-card">

                <div class="authentification-header ">
                    <div class="mb-3">
                        <i class="fa-solid fa-user-plus fa-4x"></i>
                    </div>
                    <h3 class="mb-0">Creează cont nou</h3>
                    <p class="small text-white-50 mb-0">Alătură-te comunității StanaGO în câteva secunde</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-action="Register">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control" placeholder="Prenume" />
                                    <label asp-for="FirstName"><i class="fa-solid fa-user me-1"></i> Prenume</label>
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="LastName" class="form-control" placeholder="Nume" />
                                    <label asp-for="LastName"><i class="fa-solid fa-user me-1"></i> Nume</label>
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control" placeholder="Utilizator" />
                            <label asp-for="Username"><i class="fa-solid fa-at me-1"></i> Nume Utilizator</label>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="email@exemplu.com" />
                            <label asp-for="Email"><i class="fa-solid fa-envelope me-1"></i> Adresă Email</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control" placeholder="Parola" type="password" />
                            <label asp-for="Password"><i class="fa-solid fa-lock me-1"></i> Parolă</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirma Parola" type="password" />
                            <label asp-for="ConfirmPassword"><i class="fa-solid fa-check-double me-1"></i> Confirmă Parola</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-primary btn-authentification text-uppercase">
                                Înregistrare
                            </button>
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <p class="mb-2">Ai deja un cont?</p>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark btn-sm px-4 rounded-pill">
                                Autentifică-te aici
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}