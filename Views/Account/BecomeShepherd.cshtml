@model StanaGO.ViewModels.BecomeShepherdViewModel

@{
    ViewData [ "Title" ] = "Devino Cioban";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Devino Cioban</h2>
        <p class="text-muted">Pentru a confirma că ești cioban, trebuie să furnizezi un număr de telefon valid. Contul tău va fi actualizat automat, iar tu vei putea înregistra stâne și publica produse.</p>
        <hr />

        <form method="post" asp-action="BecomeShepherd" asp-controller="Account">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="alert alert-warning mt-4" role="alert">
                <strong>Atenție!</strong> Prin această acțiune, contul tău va fi convertit permanent.
            </div>

            <div class="form-group d-flex justify-content-between mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Anulează</a>
                <button type="submit" class="btn stana-go-btn">
                    Confirmă și devino cioban
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync ("_ValidationScriptsPartial");
    }
}