@model StanaGO.Models.Profile
@using Microsoft.AspNetCore.Identity
@using StanaGO.Models

@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Profil Utilizator";

    var imgSrc = string.IsNullOrEmpty(Model.ImagePath) ? "/images/default_user.png": $"/images/profiles/{Model.ImagePath}";

    var currentUserId = UserManager.GetUserId(User);
    var isOwner = (currentUserId == Model.Id);
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <img src="@imgSrc" class="rounded-circle border border-4 border-white shadow"
                             style="width: 150px; height: 150px; object-fit: cover;" alt="Avatar">
                    </div>

                    <h2 class="card-title fw-bold">@Model.FirstName @Model.LastName</h2>

                    <div class="mb-2">
                        @if (User.IsInRole("Shepherd"))
                        {
                            <span class="badge bg-success">Cioban</span>
                        }
                        else if (User.IsInRole("Moderator"))

                        {
                            <span class="badge bg-danger">Moderator</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Casual User</span>
                        }
                    </div>

                    @if (User.IsInRole("Moderator"))
                    {
                        <p class="text-muted small">ID: @Model.Id</p>
                    }

                    <hr class="my-4" />

                    <div class="text-start px-4">
                        <div class="row mb-3">
                            <div class="col-sm-3 fw-bold text-secondary">Telefon:</div>
                            <div class="col-sm-9">@(ViewData["UserPhone"] ?? "Nespecificat")</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-3 fw-bold text-secondary">Adresă:</div>
                            <div class="col-sm-9">@(Model.Address ?? "Adresa nu a fost setată.")</div>
                        </div>

                        <div class="row mb-3">
                           @if (isOwner)
                            {
                                <div class="col-sm-3 fw-bold text-secondary">Despre tine:</div>
                            }
                            else
                            {
                                <div class="col-sm-3 fw-bold text-secondary">Despre @(Model.LastName):</div>
                            }
                            <div class="col-sm-9 fst-italic">
                                @(Model.Bio ?? "Fară descriere.")
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-grid gap-2 col-6 mx-auto">
                        @if (isOwner)
                        {
                            <a asp-action="EditProfile" class="btn btn-primary">Editează Datele</a>
                        }
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Înapoi la Hartă</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>