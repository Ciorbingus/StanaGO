@model StanaGO.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profilul meu";
}

<div class="container mt-4">
    <div class="row">

        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <img src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)"
                         alt="Avatar"
                         class="rounded-circle mb-3"
                         style="width: 150px; height: 150px; object-fit: cover;" />

                    <h4 class="card-title">
                        @Model.FirstName @Model.LastName
                    </h4>
                    <p class="text-muted mb-1">
                        @("@" + Model.Username)
                    </p>
                    <p class="text-muted mb-0">
                        @Model.Email
                    </p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Contact</h5>
                    <p class="mb-1">
                        <strong>Telefon:</strong>
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Nu este setat" : Model.PhoneNumber)
                    </p>
                    <p class="mb-1">
                        <strong>Locație:</strong>
                        @(string.IsNullOrWhiteSpace(Model.LocationText) ? "Nu este setată" : Model.LocationText)
                    </p>
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                            <p class="mb-0">
                                <strong>Coordonate:</strong>
                            @Model.Latitude.Value.ToString("0.000000"), 
                            @Model.Longitude.Value.ToString("0.000000")
                            </p>
                    }
                </div>
            </div>
        </div>


        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Despre mine</h5>
                    @if (string.IsNullOrWhiteSpace(Model.Bio))
                    {
                            <p class="text-muted mb-0">Nu ai adăugat încă o descriere.</p>
                    }
                    else
                    {
                            <p class="mb-0">@Model.Bio</p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Informații cont</h5>
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Nume complet</dt>
                        <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Username</dt>
                        <dd class="col-sm-8">@Model.Username</dd>

                        <dt class="col-sm-4">ID utilizator</dt>
                        <dd class="col-sm-8">@Model.UserId</dd>
                    </dl>


                    <a asp-controller="Account"
                       asp-action="EditProfile"
                       class="btn btn-primary mt-2">
                        ✏️ Editează profilul
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
