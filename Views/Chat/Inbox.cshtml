@model List<StanaGO.Controllers.InboxViewModel>

@{
    ViewData["Title"] = "Mesaje";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="fa-solid fa-comments text-primary"></i> Inbox</h2>

    <div class="list-group shadow-sm">
        @if (!Model.Any())
        {
            <div class="alert alert-light text-center py-5">
                <i class="fa-regular fa-paper-plane fa-3x text-muted mb-3"></i>
                <h5>Nu ai nicio conversație încă.</h5>
            </div>
        }

        @foreach (var item in Model)
        {
            <a asp-action="Chat" asp-route-id="@item.Partner.Id" class="list-group-item list-group-item-action d-flex align-items-center p-3">

                <div class="position-relative me-3">
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center border" style="width: 55px; height: 55px; overflow: hidden;">
                        @if (item.Partner.UserProfile != null && !string.IsNullOrEmpty(item.Partner.UserProfile.ImagePath))
                        {
                            <img src="~/images/profiles/@item.Partner.UserProfile.ImagePath" style="width: 100%; height: 100%; object-fit: cover;">
                        }
                        else
                        {
                            <i class="fa-solid fa-user text-secondary fa-lg"></i>
                        }
                    </div>
                    @if (item.UnreadCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light">
                            @item.UnreadCount
                        </span>
                    }
                </div>

                <div class="flex-grow-1 overflow-hidden">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="mb-0 fw-bold text-dark">@item.Partner.FirstName @item.Partner.LastName</h6>
                        <small class="text-muted" style="font-size: 0.8rem;">@item.SentTime.ToString("HH:mm, dd MMM")</small>
                    </div>
                    <p class="mb-0 text-muted text-truncate small">
                        @(item.UnreadCount > 0 ? Html.Raw($"<strong class='text-dark'>{item.LastMessage}</strong>") : item.LastMessage)
                    </p>
                </div>
            </a>
        }
    </div>
</div>